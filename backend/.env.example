
PINECONE_API_KEY=your_pinecone_api_key_here

# Your index name (must match what you created in the Pinecone dashboard)
PINECONE_INDEX_NAME=slake-index

# Your index host URL (found in Pinecone dashboard → Index → "Host")
PINECONE_HOST=https://slake-index-gmci4oc.svc.aped-4627-b74a.pinecone.io

# Namespace to organise vectors within the index
PINECONE_NAMESPACE=slake-vqa

# ── Generative LLM API Keys (at least one recommended) ───────────────────────
# Option A: HuggingFace Inference API (for LLaVA-1.5-7B)
HF_TOKEN=your_huggingface_token_here

# Option B: Google Gemini API (fastest, most reliable)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides ────────────────────────────────────────────────────────
# Force a specific engine: huggingface_api | gemini_api | local_moondream | local_llava
# GENERATIVE_ENGINE=gemini_api
